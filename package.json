{
  "name": "youdub-webui-fullstack",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "start": "npm --prefix apps/desktop run start",
    "build": "npm --prefix apps/web run build && npm --prefix apps/desktop run build",
    "test": "npm --prefix apps/web run test && npm run test:backend",
    "test:backend": "node scripts/test-backend.mjs",
    "test:downloads": "node --test scripts/download-releases.test.mjs",
    "typecheck": "npm --prefix apps/web run typecheck && npm --prefix apps/desktop run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "package:desktop": "node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
